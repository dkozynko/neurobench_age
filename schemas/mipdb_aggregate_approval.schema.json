{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurobench-age.invalid/schemas/mipdb_aggregate_approval.schema.json",
  "title": "MIPDB aggregate supplement approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_digest_sha256",
    "release_scope_sha256",
    "release_class",
    "access_scope",
    "status",
    "dataset_terms_status",
    "privacy_status",
    "disclosure_review_status",
    "reviewer_id",
    "reviewed_at_utc",
    "audience",
    "revoked"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_digest_sha256": {"$ref": "#/$defs/sha256"},
    "release_scope_sha256": {"$ref": "#/$defs/sha256"},
    "release_class": {"const": "controlled_review"},
    "access_scope": {"const": "controlled_review"},
    "status": {"const": "approved"},
    "dataset_terms_status": {"const": "approved"},
    "privacy_status": {"const": "approved"},
    "disclosure_review_status": {"const": "approved"},
    "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "reviewed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?\\+00:00$"
    },
    "audience": {"enum": ["named_reviewers", "data_access_committee"]},
    "revoked": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
