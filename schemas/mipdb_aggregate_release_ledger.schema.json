{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurobench-age.invalid/schemas/mipdb_aggregate_release_ledger.schema.json",
  "title": "MIPDB aggregate supplement release ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_version", "anchor_sha256", "previous_ledger_sha256", "entries", "ledger_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "ledger_version": {"type": "integer", "minimum": 1},
    "anchor_sha256": {"$ref": "#/$defs/sha256"},
    "previous_ledger_sha256": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    },
    "ledger_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_digest_sha256", "release_scope_sha256", "release_class", "audience", "status", "entry_sha256"],
      "properties": {
        "candidate_digest_sha256": {"$ref": "#/$defs/sha256"},
        "release_scope_sha256": {"$ref": "#/$defs/sha256"},
        "release_class": {"const": "controlled_review"},
        "audience": {"enum": ["named_reviewers", "data_access_committee"]},
        "status": {"enum": ["active", "revoked"]},
        "entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
