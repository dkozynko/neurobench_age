{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurobench-age.local/schemas/ds006780_precision_scenarios.schema.json",
  "title": "ds006780 planning-only precision scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "status", "scenarios"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "planning_only"},
    "notes": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseline_correlation",
        "candidate_correlation",
        "paired_error_correlation",
        "seed_delta_sd"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "baseline_correlation": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1},
        "candidate_correlation": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1},
        "paired_error_correlation": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1},
        "seed_delta_sd": {"type": "number", "minimum": 0},
        "target_distribution": {"type": "string", "enum": ["normal", "uniform"]}
      }
    }
  }
}
